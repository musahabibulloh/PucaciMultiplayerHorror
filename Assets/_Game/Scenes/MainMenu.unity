--- !u!114 &1657891808
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1657891806}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFB347><b>SURVIVOR</b></color>\n\u2022 Hancurkan 5 sesajen di
    kampung sebelum waktu habis.\n\u2022 Tahan <b>[E]</b> di depan sesajen untuk
    merusaknya.\n\u2022 Jangan sendirian \u2014 hantu bisa menyerupai rekanmu.\n\n<color=#FF6B5B><b>KUNTILANAK
    (IMPOSTOR)</b></color>\n\u2022 Bunuh semua survivor tanpa ketahuan.\n\u2022 <b>[1/2/3/T]</b>
    menyamar jadi manusia, <b>[F]</b> wujud gaib.\n\u2022 <b>[M1/E]</b> cekik korban,
    <b>[Q]</b> sabotase lampu jalan.\n\u2022 Dalam wujud manusia, kau bisa merusak
    / memperbaiki sesajen untuk mengelabui tim.\n\n<color=#8FB3FF><b>TIPS</b></color>\n\u2022
    Lampu mati = hantu sedang dekat. Nyalakan kembali untuk bertahan.\n\u2022 Suara
    keras menarik perhatian. Berbisiklah saat bersembunyi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3703b52ce7dcb4f4f91d02d169967234, type: 2}
  m_sharedMaterial: {fileID: -3147653409388508289, guid: 3703b52ce7dcb4f4f91d02d169967234, type: 2}
